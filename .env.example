VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push public key — Firebase Console > Project Settings > Cloud Messaging
# > Web configuration > "Generate key pair". Public by design (it's the
# public half of the VAPID keypair), safe in the client bundle.
VITE_FIREBASE_VAPID_KEY=

# Server-side only (api/kido-sor.ts) — never prefix with VITE_, this must not
# reach the client bundle. Set as a Vercel project environment variable.
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server-side only (api/notify-family.ts) — the full JSON content of a
# service account key (Firebase Console > Project Settings > Service
# Accounts > Generate new private key), used to mint short-lived tokens for
# the Firestore + FCM send REST APIs without pulling in firebase-admin.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server-side only (api/nobetci-eczane.ts) — never prefix with VITE_.
# CollectAPI token (collectapi.com > Profile > Token) for the duty-pharmacy
# lookup API.
COLLECTAPI_KEY=
