rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(familyId) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/deviceTokens/{tokenId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /families/{familyId} {
      // Any signed-in user may look up a family by its invite-code document
      // id (getDoc — see stores/auth.ts, the only place the app ever reads
      // this collection). Deliberately `get`, not `read` (`read` = get +
      // list): a condition here that doesn't inspect `resource.data` holds
      // for every document uniformly, so `allow read` would let anyone
      // signed in run `getDocs(collection(db,'families'))` and enumerate
      // every family (invite code, ownerUid, member uids) in the database —
      // list is intentionally left ungranted.
      allow get: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid] == true;

      // Existing members can update freely. A non-member may only add their
      // own uid to `members` (the invite-code join flow) — nothing else.
      // `members` is a nested map, so the diff must be taken on that map
      // itself, not on the document's top-level fields.
      allow update: if request.auth != null && (
        isMember(familyId) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.diff(resource.data.members).addedKeys().hasOnly([request.auth.uid]) &&
          request.resource.data.members.diff(resource.data.members).removedKeys().size() == 0 &&
          request.resource.data.members.diff(resource.data.members).changedKeys().size() == 0
        )
      );
    }

    match /families/{familyId}/children/{childId} {
      allow read, write: if isMember(familyId);
    }

    match /families/{familyId}/children/{childId}/entries/{entryId} {
      allow read, write: if isMember(familyId);
    }

    match /families/{familyId}/children/{childId}/medications/{medicationId} {
      allow read, write: if isMember(familyId);
    }

    match /families/{familyId}/children/{childId}/feedings/{feedingId} {
      allow read, write: if isMember(familyId);
    }

    match /families/{familyId}/children/{childId}/growth/{growthId} {
      allow read, write: if isMember(familyId);
    }

    match /families/{familyId}/children/{childId}/symptoms/{symptomId} {
      allow read, write: if isMember(familyId);
    }

    match /families/{familyId}/children/{childId}/sleep/{sleepId} {
      allow read, write: if isMember(familyId);
    }

    match /families/{familyId}/children/{childId}/diapers/{diaperId} {
      allow read, write: if isMember(familyId);
    }

    // Written by the server (api/check-medication-courses.ts, using the
    // admin-authenticated service account, which bypasses rules) — the
    // client only ever reads these, but member-write stays allowed for
    // consistency with every other subcollection here.
    match /families/{familyId}/children/{childId}/medicationAlerts/{alertId} {
      allow read, write: if isMember(familyId);
    }
  }
}
